        // The door: a kinematic body that follows its Transform (the game slides it up).
        (id: 20, name: "Door", position: (0.0, 1.5, 0.0), rotation: (0.0, 0.0, 0.0), scale: (2.4, 3.0, 0.3),
            mesh: Some((shape: Cube, color: (0.75, 0.2, 0.15, 1.0))),
