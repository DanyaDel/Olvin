            collider: Some((shape: Sphere(radius: 0.5), center: (0.0, 0.0, 0.0), is_trigger: false, friction: 0.4, restitution: 0.4)),
            rigidbody: Some((kind: Dynamic, mass: 1.0, drag: 0.2, angular_drag: 0.3, gravity_scale: 1.0, freeze_rotation: (false, false, false), ccd: false))),

        // Humming beacon: positional looping sound, spun by a Lua behaviour,
        // which also notices the player in its trigger sphere.
        (id: 50, name: "Beacon", position: (-8.0, 1.0, 8.0), rotation: (0.0, 0.0, 0.0), scale: (0.4, 1.0, 0.4),
            mesh: Some((shape: Cylinder, color: (0.2, 0.9, 0.6, 1.0))),
            collider: Some((shape: Sphere(radius: 2.0), center: (0.0, 0.0, 0.0), is_trigger: true, friction: 0.6, restitution: 0.0)),
            audio_source: Some((clip: "sfx/hum.wav", volume: 0.7, pitch: 1.0, looping: true, play_on_awake: true, spatial: true, min_distance: 1.0, max_distance: 14.0)),
            scripts: [(name: "beacon", params: {"speed": "90"})]),
        (id: 51, name: "Beacon Light", position: (-8.0, 2.6, 8.0), rotation: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0),
            light: Some((kind: Point, color: (0.3, 1.0, 0.7), intensity: 4.0, range: 7.0, spot_angle: 30.0, shadows: false))),

        // North room: the robot and its light.
        // The game sets "near" while the player is within 3.5 m and turns the robot to face them.
        (id: 60, name: "Robot", position: (0.0, 0.0, -6.0), rotation: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0),
            model: Some((
                path: "models/robot.gltf",
                animation: Some(Inline((
                    initial: "Idle",
                    params: {"near": Bool(false)},
                    states: [
                        (name: "Idle", motion: Clip("Idle")),
                        (name: "Wave", motion: Clip("Wave")),
                    ],
                    transitions: [
                        (from: Some("Idle"), to: "Wave", when: [("near", True)], duration: 0.25),
                        (from: Some("Wave"), to: "Idle", when: [("near", False)], duration: 0.4),
                    ],
                ))),
            )),
            collider: Some((shape: Capsule(radius: 0.35, height: 1.9), center: (0.0, 0.95, 0.0), is_trigger: false, friction: 0.6, restitution: 0.0))),
        (id: 61, name: "Room Light", position: (0.0, 3.2, -6.0), rotation: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0),
            light: Some((kind: Point, color: (1.0, 0.8, 0.55), intensity: 6.0, range: 10.0, spot_angle: 30.0, shadows: false))),

        // Player: character controller; the camera (and the ears) are a child at eye height.
        (id: 100, name: "Player", position: (0.0, 1.0, 10.0), rotation: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0),
            character_controller: Some((height: 1.8, radius: 0.4, step_offset: 0.3, slope_limit_deg: 45.0)),
            components: {"Player": "()", "PlayerLook": "(yaw: 0.0, pitch: 0.0)"}),
        (id: 101, name: "Player Camera", parent: Some(100), position: (0.0, 0.7, 0.0), rotation: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0),
            camera: Some((fov_deg: 75.0, near: 0.05, far: 200.0)),
            audio_listener: true,
            components: {"PlayerCamera": "()"}),
    ],
)
