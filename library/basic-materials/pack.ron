(
  id: "basic-materials",
  name: "Basic Materials",
  version: "1.0.0",
  category: Materials,
  description: "Ten plain PBR presets: stone, brick, wood, steel, gold, plastic, rubber, glass, emissive and grass. Colour and roughness values only, no textures.",
  tags: ["pbr", "starter", "materials"],
  author: "NLPA Collab",
  license: "MIT OR Apache-2.0",
  requires: [],
  provides: [
    "basic-materials/materials/brick.mat.ron",
    "basic-materials/materials/emissive.mat.ron",
    "basic-materials/materials/glass.mat.ron",
    "basic-materials/materials/gold.mat.ron",
    "basic-materials/materials/grass.mat.ron",
    "basic-materials/materials/plastic.mat.ron",
    "basic-materials/materials/rubber.mat.ron",
    "basic-materials/materials/steel.mat.ron",
    "basic-materials/materials/stone.mat.ron",
    "basic-materials/materials/wood.mat.ron",
  ],
  notes: "Values are linear. Glass uses `alpha_blend`. Pair with any mesh or primitive.",
)
