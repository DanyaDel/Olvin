            scripts: [(name: "enemy-ai/enemy", params: {"patrol": "", "patrol_speed": "2.0", "patrol_wait": "1.0", "chase_speed": "4.5", "sight_range": "12.0", "fov": "150.0", "lose_range": "18.0", "lose_time": "4.0", "attack_range": "1.8", "attack_damage": "10.0", "attack_cooldown": "1.2", "eye_height": "0.6", "player": "Player", "attack_sound": ""}), (name: "health-damage/health", params: {"max_health": "40.0", "start_health": "0.0", "invulnerable_time": "0.2", "var": "", "destroy_on_death": "true", "respawn_delay": "-1.0", "hurt_sound": "", "death_sound": ""})]),
        (id: 2, name: "Body", parent: Some(1), position: (0.0, 0.0, 0.0), rotation: (0.0, 0.0, 0.0), scale: (0.8, 0.9, 0.8),
