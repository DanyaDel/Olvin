(
  id: "looks-cinematic",
  name: "Cinematic Looks",
  version: "1.0.0",
  category: Looks,
  description: "Eight picture looks (Neutral, Cinematic, Noir, Vibrant, PS1, Night Vision, Dreamy, Horror): exposure, tonemapping, bloom, colour grading and fog in one asset.",
  tags: ["look", "filter", "grading", "post"],
  author: "NLPA Collab",
  license: "MIT OR Apache-2.0",
  requires: [],
  provides: [
    "looks-cinematic/looks/cinematic.look.ron",
    "looks-cinematic/looks/dreamy.look.ron",
    "looks-cinematic/looks/horror.look.ron",
    "looks-cinematic/looks/neutral.look.ron",
    "looks-cinematic/looks/night_vision.look.ron",
    "looks-cinematic/looks/noir.look.ron",
    "looks-cinematic/looks/ps1.look.ron",
    "looks-cinematic/looks/vibrant.look.ron",
    "looks-cinematic/luts/night_vision.png",
    "looks-cinematic/luts/retro_ps1.png",
  ],
  notes: "Apply from Settings > Rendering > Look. PS1 also switches the retro render style on (see the retro-ps1 pack and Settings > Rendering > Retro / PS1). Bloom, grading, LUT, FXAA and AO need the Full render tier and show in the game window, not the editor viewport. The same looks are built into the editor.",
)
